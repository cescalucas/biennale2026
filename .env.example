# Copie este arquivo para .env.local (não-versionado) e preencha os valores.
# Sem essas variáveis o app cai automaticamente nos dados locais em src/data/.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key

# Somente para o script de seed (scripts/seed-supabase.mjs).
# NUNCA exponha a service role no front-end nem em build do Netlify.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
